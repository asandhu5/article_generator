# ============================================================================
# OpenAI -- required
# ============================================================================
# Get a key at https://platform.openai.com/api-keys (you'll need billing set
# up on your OpenAI account -- generation isn't available on a free tier).
OPENAI_API_KEY=

# ============================================================================
# App
# ============================================================================
HOST=127.0.0.1
# 5000 is macOS's AirPlay Receiver port by default -- this app defaults to
# 5050 instead so you don't have to fight that conflict.
PORT=5050
